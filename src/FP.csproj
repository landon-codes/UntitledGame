<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project Configuration -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Output Secifications -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <OutputType>Exe</OutputType>
  </PropertyGroup> 
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!-- Dependancies -->
  <ItemGroup>
    <PackageReference Include="BaobabEngine.Baobab" Version="0.2.1" />
    <PackageReference Include="FosterFramework" Version="0.3.0" />
   </ItemGroup>

   <!-- Includes assets in the project -->
   <ItemGroup>
     <None Include="Assets\**\*">
       <CopyToOutputDirectory>Always</CopyToOutputDirectory>
       <Link>Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
     </None>
   </ItemGroup>
   <ItemGroup>
     <ProjectReference Include="..\Foster.Audio\Foster.Audio\Foster.Audio.csproj" />
   </ItemGroup>
  
</Project>
